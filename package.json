{
  "name": "aptora",
  "version": "1.3.2",
  "description": "Aptora - Testing & Grading App",
  "main": "server/server.js",
  "scripts": {
    "sync:version": "node scripts/sync-version.js",
    "install:all": "npm ci --cache .npm-cache && npm ci --prefix server --cache .npm-cache && npm ci --prefix client --cache .npm-cache",
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build:client": "npm run build --prefix client",
    "build:installer": "deployment\\windows\\build-installer.bat",
    "start": "node server/server.js"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
