# Environment-variable reference. This file is not loaded automatically.
# Required in production
NODE_ENV=production
PUBLIC_URL=http://192.168.1.50:9372
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SESSION_LINK_TTL_HOURS=72
RESULT_LINK_TTL_HOURS=168
SESSION_SUBMIT_GRACE_SECONDS=30
# Must be exactly 32 ASCII characters/bytes and must never change after setup
ENCRYPTION_KEY=replace-with-exactly-32-chars!!!

TRUST_PROXY=false
PORT=9372
APTORA_LISTEN_HOST=0.0.0.0
# Explicit opt-ins for direct HTTP access without DNS/TLS/reverse proxy.
ALLOW_PUBLIC_NODE_BIND=true
ALLOW_INSECURE_HTTP=true

# Comma-separated. Normally PUBLIC_URL alone is enough.
ALLOWED_ORIGINS=http://192.168.1.50:9372

AUTH_RATE_LIMIT=15
AUDIT_RETENTION_DAYS=180
